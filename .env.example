# Template for .env: copy it, fill in the values, and never commit .env.
# Demo/practice keys only. Live keys never go in this file (docs/05 §9).

# Trading 212, PRACTICE account (app: Settings → API). Basic auth: key + secret.
T212_DEMO_API_KEY=
T212_DEMO_API_SECRET=

# Alpaca: US market data and news only; the bot never trades there.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Alerts (optional; the engine runs without them). Telegram: create a bot with @BotFather, send it a message,
# then read your chat id from https://api.telegram.org/bot<token>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dead-man's switch: a healthchecks.io check (period 10 min, grace 10 min). Paste its ping URL.
HC_PING_URL=
